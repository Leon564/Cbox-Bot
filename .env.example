OPENAI_API_KEY = sk-xxx
GEMINI_API_KEY= example

CBOX_URL = https://my.cbox.ws/example or https://www4.cbox.ws/box/?boxid=xxxxx&boxtag=xxxx
CBOX_USERNAME = example
CBOX_PASSWORD = example
CBOX_DEFAULT_PIC= https://cbox.im/i/mUYUb.jpg

DISCORD_URL = https://discord.gg/your-server-invite

MAX_LENGTH_RESPONSE = 200
CONTEXT_LENGTH = 5
TEXT_COLOR= b95dff
RESPONSE_DELAY = 1000
USE_MEMORY = true  # true/false - Activar sistema de memoria inteligente para recordar preferencias del usuario

# Configuración de moderación automática
MODERATION_ENABLED = true      # true/false - Activar moderación con GPT
AUTO_MODERATE_ALL = false      # true/false - Moderar TODOS los mensajes (no solo dirigidos al bot)
AUTO_DELETE_MESSAGES = true    # true/false - Eliminar automáticamente mensajes para timeout/ban
MODERATION_ONLY_MODE = false   # true/false - Solo moderar sin chatear ni responder comandos

# Configuración del servicio de subida de archivos
# catbox = permanente, litterbox = temporal (se borra automáticamente)
UPLOAD_SERVICE = catbox  # catbox/litterbox
LITTERBOX_EXPIRY = 1h    # Tiempo de expiración para litterbox: 1h, 12h, 24h, 72h

# Configuración de cookies de YouTube (opcional)
# Ruta al archivo de cookies JSON para acceder a contenido restringido de YouTube
YOUTUBE_COOKIES_PATH = ./auth_info/youtube-cookies.json
